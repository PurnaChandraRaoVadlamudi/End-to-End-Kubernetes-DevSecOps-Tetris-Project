pipeline {
    agent any

    tools {
        nodejs 'nodejs'
    }

    environment {
        SCANNER_HOME = tool 'sonar-scanner'
    }

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout Code') {
            steps {
                git branch: 'master',
                url: 'https://github.com/PurnaChandraRaoVadlamudi/End-to-End-Kubernetes-DevSecOps-Tetris-Project.git'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('Tetris-V2') {
                    withSonarQubeEnv('sonar-server') {
                        sh """
                        $SCANNER_HOME/bin/sonar-scanner \
                        -Dsonar.projectKey=Tetris \
                        -Dsonar.projectName=Tetris \
                        -Dsonar.sources=.
                        """
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                script {
                    def qg = waitForQualityGate()
                    echo "Quality Gate: ${qg.status}"

                    if (qg.status != 'OK') {
                        error "❌ Quality Gate Failed"
                    }
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('Tetris-V2') {
                    sh 'npm install'
                }
            }
        }

        stage('OWASP Dependency Scan (No API Key)') {
            steps {
                dir('Tetris-V2') {
                    dependencyCheck additionalArguments: '''
                        --scan .
                        --disableYarnAudit
                        --disableNodeAudit
                        --format HTML
                    ''',
                    odcInstallation: 'DP-Check'

                    dependencyCheckPublisher pattern: '**/dependency-check-report.xml'
                }
            }
        }

        stage('Trivy File Scan') {
            steps {
                dir('Tetris-V2') {
                    sh 'trivy fs . --format table > trivyfs.txt'
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('Tetris-V2') {
                    sh '''
                    docker system prune -f
                    docker build -t tetrisv2 .
                    '''
                }
            }
        }

        stage('Docker Push') {
            steps {
                withDockerRegistry(credentialsId: 'docker', url: 'https://index.docker.io/v1/') {
                    sh """
                    docker tag tetrisv2 purna7/tetrisv2:${BUILD_NUMBER}
                    docker push purna7/tetrisv2:${BUILD_NUMBER}
                    """
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh 'trivy image purna7/tetrisv2:${BUILD_NUMBER} --format table > trivyimage.txt'
            }
        }

        stage('Update Deployment File') {
            environment {
                GIT_REPO_NAME = "End-to-End-Kubernetes-DevSecOps-Tetris-Project"
                GIT_USER_NAME = "PurnaChandraRaoVadlamudi"
            }

            steps {
                dir('Manifest-file') {
                    withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {

                        sh """
                        git config user.email "purna0277@gmail.com"
                        git config user.name "purna"

                        echo "Updating image to: purna7/tetrisv2:${BUILD_NUMBER}"

                        # 🔥 SIMPLE & SAFE REPLACE
                        sed -i 's|image: .*tetrisv2.*|image: purna7/tetrisv2:${BUILD_NUMBER}|g' deployment-service.yml

                        cat deployment-service.yml

                        git add deployment-service.yml
                        git commit -m "Update image to ${BUILD_NUMBER}" || echo "No changes"
                        git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:master
                        """
                    }
                }
            }
        }
    }
}
